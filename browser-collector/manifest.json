{
  "manifest_version": 3,
  "name": "语雀本机备份采集器",
  "version": "0.5.0",
  "description": "复用浏览器登录态，盘点自有知识库并可恢复地采集已确认发布版本的普通文档。",
  "permissions": ["activeTab", "downloads"],
  "host_permissions": ["https://www.yuque.com/*", "https://cdn.nlark.com/*", "https://cdn.yuque.com/*"],
  "action": {"default_title": "采集语雀当前文章", "default_popup": "popup.html"}
}
